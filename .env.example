# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Supabase (leave blank to run in demo mode with an in-memory store) ----------
# Only public keys are needed: privileged work runs inside SECURITY DEFINER SQL functions.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------- Staff auth ----------
# Production: staff sign in with Supabase Auth; their email must exist in the `staff` table.
# Demo mode (no Supabase): passcode login for /admin.
ADMIN_PASSCODE=route86
AUTH_SECRET=change-me-to-a-long-random-string

# ---------- WhatsApp ----------
# twilio | meta | none
WHATSAPP_PROVIDER=none
# Twilio (WhatsApp sender or sandbox)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Optional approved templates for business-initiated messages (text goes in {{1}})
TWILIO_CONTENT_SID_ORDER_RECEIVED=
TWILIO_CONTENT_SID_ORDER_READY=
TWILIO_CONTENT_SID_ORDER_OUT_FOR_DELIVERY=
TWILIO_CONTENT_SID_ORDER_CANCELLED=
TWILIO_CONTENT_SID_STORE_NEW_ORDER=
# Meta WhatsApp Cloud API (alternative to Twilio)
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_TEMPLATE_LANG=en_US
META_WA_TEMPLATE_ORDER_RECEIVED=
META_WA_TEMPLATE_ORDER_READY=

# ---------- Email (Resend) ----------
RESEND_API_KEY=
EMAIL_FROM=Route 86 <orders@yourdomain.com>

# ---------- Store alerts (fallbacks; the Settings page in /admin overrides these) ----------
STORE_WHATSAPP=+12642358686
STORE_EMAIL=
